#!/bin/bash
#PBS -N eegprism
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=24:00:00
#PBS -j oe

set -euo pipefail

REPO="${PRISM_REPO:-$HOME/PRISM/PRISM}"
PYTHON_BIN="${PRISM_PYTHON:-$HOME/venvs/prism/bin/python}"
OUTDIR="${PRISM_EEG_OUTDIR:-data/results_prism/eeg_prism_central_full_pca_q4}"

cd "$REPO"
mkdir -p logs
exec > "logs/eeg_prism_central_full_${PBS_JOBID:-manual}.log" 2>&1

echo "started $(date)"
echo "repo=$REPO"
echo "python=$PYTHON_BIN"
echo "outdir=$OUTDIR"
echo "job=${PBS_JOBID:-manual}"

module load Python/3.11.3-GCCcore-12.3.0
source "$HOME/venvs/prism/bin/activate"

N_JOBS="${PBS_NCPUS:-8}"
export PYTHONPATH="$REPO/data/processing:$REPO/src:${PYTHONPATH:-}"
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export MPLBACKEND=Agg
export MPLCONFIGDIR="${TMPDIR:-/tmp}/prism-mpl"
export XDG_CACHE_HOME="${TMPDIR:-/tmp}/prism-cache"

"$PYTHON_BIN" data/processing/run.py prism-region-window \
  --all-subjects \
  --export-dir data/exports_mat \
  --derivatives-dir data/ds001785/derivatives/eegprep \
  --outdir "$OUTDIR" \
  --regions central \
  --rep-dims 4 \
  --projection-modes pca \
  --macro-builder hierarchical_complete \
  --macro-eps 0.25 \
  --macro-bins 3 \
  --em-iters 20 \
  --em-tol 1e-3 \
  --train-start-ms -300 \
  --train-end-ms 0 \
  --test-start-ms 125 \
  --test-end-ms 375 \
  --n-jobs "$N_JOBS"

echo "finished $(date)"
